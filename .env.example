# Copy to .env and fill in the keys for the providers you use.
# .env is gitignored; NEVER commit real keys. Names match config/runtime.example.yaml.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
HETZNER_INFERENCE_API_KEY=
# GEMINI_API_KEY=
# LOCAL_API_KEY=      # usually unused for Ollama/vLLM

# Host tool backends (ADR 0016 / 0020). Defaults are honest offline stubs.
# Web search: TAVILY_API_KEY alone auto-enables Tavily.
# Force offline: MKLANG_SEARCH_BACKEND=stub
# Demo without network: MKLANG_SEARCH_BACKEND=fake
# TAVILY_API_KEY=
# MKLANG_SEARCH_BACKEND=tavily
# KB showcase tool: MKLANG_KB_BACKEND=stub|fake
# Mail showcase tool: MKLANG_MAIL_BACKEND=stub|fake  (fake = in-memory outbox)
# Process logging (best practices §12): mklang.* hierarchy on stderr.
# MKLANG_LOG_LEVEL=info      # debug|info|warning|error (default: warning)

# Filesystem data tools (ADR 0024): live reads under MKLANG_FS_ROOT or the cwd.
# MKLANG_FS_ROOT=            # workspace root (default: current directory)
# MKLANG_FS_BACKEND=stub     # stub|none|off force offline (CI); local/unset = real disk
# MKLANG_FS_WRITE=1          # grant write_file on real disk (headless runs)

# Host layout and policy (ADR 0021; docs/guides/best-practices.md).
# MKLANG_CONFIG=             # explicit runtime.yaml path (beats project/user/system layers)
# MKLANG_CONFIG_DIR=         # override the XDG config dir (~/.config/mklang)
# MKLANG_DATA_DIR=           # override the XDG data dir (~/.local/share/mklang)
# MKLANG_STATE_DIR=          # override the XDG state dir (~/.local/state/mklang)
# MKLANG_ALLOWED_PLUGINS=    # comma-separated allowlist of entry-point plugins (security)
# MKLANG_DEBUG=1             # console: show full tracebacks
