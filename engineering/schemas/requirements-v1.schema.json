{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gianlucamazza/mklang-engineering/schemas/requirements-v1.schema.json",
  "title": "MKLANG requirement registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "enum": [
        "mklang",
        "mklang-platform",
        "mklang-engineering",
        "software-factory"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "scope",
          "statement",
          "rationale",
          "category",
          "priority",
          "lifecycle",
          "risk",
          "acceptance",
          "verification",
          "depends_on",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(PRD|LREQ|FREQ|QREQ|SREQ|DREQ|IREQ|OREQ|EREQ)-(ENG|MKL|MKP|FCT)-[0-9]{4}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "PRD",
              "LREQ",
              "FREQ",
              "QREQ",
              "SREQ",
              "DREQ",
              "IREQ",
              "OREQ",
              "EREQ"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "lifecycle": {
            "enum": [
              "proposed",
              "reviewed",
              "accepted",
              "implemented",
              "verified",
              "released",
              "deprecated",
              "rejected"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "method"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "structural",
                  "evidence",
                  "semantic"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "references": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "implementation",
              "tests",
              "adr",
              "evidence"
            ],
            "properties": {
              "implementation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "contains": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "uniqueItems": true
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "contains": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "uniqueItems": true
              },
              "adr": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "contains": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "uniqueItems": true
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "contains": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
